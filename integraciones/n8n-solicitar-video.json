              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5d1b7082-bf9f-4c03-9d12-ce26e17a8740",
      "name": "Descargar video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1600,
        -100
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ $('Preparar solicitud').first().json.base_url + $json.artifact.video_url }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "video"
            }
          }
        }
      }
    },
    {
      "id": "5f4f7596-3c04-4abe-8393-4f12543c445e",
      "name": "Revisar estado y plazo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1550,
        160
      ],
      "parameters": {
        "jsCode": "if (!['queued','running'].includes($json.status)) throw new Error($json.error || ('Estado: '+$json.status)); if(Date.now()-$('Preparar solicitud').first().json.started_at>30*60*1000) throw new Error('Plazo agotado; consultar el mismo trabajo, no crear otro.'); return $input.all();"
      }
    },
