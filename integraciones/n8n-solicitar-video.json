      "parameters": {
        "jsCode": "return [{json:{base_url:'http://127.0.0.1:4173',idempotency_key:'piloto-centro-comercial-001',started_at:Date.now(),request:{brand_id:'comandpos',kind:'video',template_id:'comercial-n8n',voice:true,subtitles:true,allow_paid_voice:false,brief:'Prueba del centro multimedia; no publicar.'}}}];"
      }
    },
    {
      "id": "318b8447-221a-47f8-a1fc-e0b4aa1f6294",
      "name": "Solicitar video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "url": "={{ $json.base_url + '/api/v1/jobs' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "b9065be0-582a-4488-9b51-b1830dfa5c57",
      "name": "Guardar ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{job_id:$json.job.id}}];"
      }
    },
    {
      "id": "962e71d7-b1b1-43e3-ba95-6772a66cf778",
      "name": "Esperar",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        900,
        0
      ],
      "parameters": {
        "amount": 15,
        "unit": "seconds"
      }
    },
    {
      "id": "7f4ace48-60e1-47d0-bfa3-a2ea48d84df2",
      "name": "Consultar trabajo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "url": "={{ $('Preparar solicitud').first().json.base_url + '/api/v1/jobs/' + $('Guardar ID').first().json.job_id }}",
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "6e356ed6-1eff-43fb-a361-18727c23898a",
      "name": "Esta listo",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1350,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
