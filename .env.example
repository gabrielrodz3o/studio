# Referencia de configuración; el servidor lee variables del entorno.
# No guardar valores reales de acceso en Git.
STUDIO_PORT=4173
STUDIO_BIND_HOST=127.0.0.1
STUDIO_ORIGIN=http://127.0.0.1:4173
STUDIO_REQUIRE_LOGIN=1
STUDIO_DAILY_BUDGET=5
# OPENAI_API_KEY=
# STUDIO_API_TOKEN=
# Consulta voz.mjs para la configuración de KIE y LEEME.md para Whisper.
# Ads: preparación/lectura por defecto; habilitar escritura exige fase autorizada.
STUDIO_ADS_ENABLE_WRITES=0
# STUDIO_META_ADS_TOKEN= (solo en configuración privada, nunca completar este ejemplo)
# STUDIO_TIKTOK_ADS_TOKEN= (Business API, distinto de Content Posting)
